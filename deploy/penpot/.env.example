# Copy to .env and fill in. Never commit .env.

# --- Penpot ---------------------------------------------------------------
# Pin an exact version. Upgrade by changing it (backup first, see README).
PENPOT_VERSION=2.18.4
PENPOT_DOMAIN=design.alphanusa.id

# Master key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Database password (any long random string). Do not change it after the first
# start: the database is created with it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PENPOT_DB_PASSWORD=

# Extra Penpot flags appended to the defaults in docker-compose.yml (optional)
PENPOT_EXTRA_FLAGS=

# --- Login with Logto (OIDC) ------------------------------------------------
# From the Logto application (type "Traditional web"), see README step 1.
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
# Logto "Issuer endpoint" WITH a trailing slash:
LOGTO_ISSUER=https://auth.alphanusa.id/oidc/

# Login button label
PENPOT_OIDC_NAME=Alphanusa

# Optional: restrict Penpot to users with a Logto role (e.g. "penpot").
# Then also add the "roles" scope:
# PENPOT_OIDC_SCOPES=openid profile email roles
# PENPOT_OIDC_ROLES=penpot
PENPOT_OIDC_SCOPES=openid profile email
PENPOT_OIDC_ROLES=

# Only if the Logto domain resolves to a private IP from this server:
# PENPOT_SSRF_ALLOWED_HOSTS=auth.alphanusa.id
PENPOT_SSRF_ALLOWED_HOSTS=

# --- Traefik (already running on this server) -------------------------------
# Docker network Traefik is attached to:   docker network ls
TRAEFIK_NETWORK=traefik
# HTTPS entrypoint name in Traefik's static config (often "websecure")
TRAEFIK_ENTRYPOINT=websecure
# Certificate resolver name in Traefik's static config (often "letsencrypt")
TRAEFIK_CERTRESOLVER=letsencrypt
