{:deps {:aliases [:dev]}

 :builds
 {:engine
  {:target :esm
   :runtime :node
   :output-dir "dist/"

   :modules
   {:engine
    {:exports {init            penpot-mcp.engine/init
               rpc             penpot-mcp.engine/rpc-js
               renderShape     penpot-mcp.engine/render-shape
               pageSummary     penpot-mcp.engine/page-summary
               applyOps        penpot-mcp.engine/apply-ops
               applyOpsOffline penpot-mcp.engine/apply-ops-offline
               createProject   penpot-mcp.engine/create-project
               createFile      penpot-mcp.engine/create-file
               filePages       penpot-mcp.engine/file-pages
               editPages       penpot-mcp.engine/edit-pages
               listFonts       penpot-mcp.engine/list-fonts
               uploadImage     penpot-mcp.engine/upload-image
               uploadFont      penpot-mcp.engine/upload-font
               importLibrary   penpot-mcp.engine/import-library
               linkLibrary     penpot-mcp.engine/link-library
               libraryAssets   penpot-mcp.engine/library-assets
               editLibrary     penpot-mcp.engine/edit-library
               pagesOffline    penpot-mcp.engine/pages-offline
               libraryOffline  penpot-mcp.engine/library-offline
               editLibraryOffline penpot-mcp.engine/edit-library-offline
               fileTransit     penpot-mcp.engine/file-transit
               imageInfo       penpot-mcp.engine/image-info
               renderDemo      penpot-mcp.engine/render-demo}}}

   ;; Same resolution settings as Penpot's exporter build.
   :js-options
   {:entry-keys ["module" "browser" "main"]
    :export-conditions ["module" "import" "browser" "require" "default"]
    :js-provider :import}

   :compiler-options
   {:output-feature-set :es2020
    :output-wrapper false}

   :release
   {:compiler-options
    {:fn-invoke-direct true
     :optimizations :simple
     :source-map true}}}}}
